{
  "name": "geometry-processing-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first browser lab for inspectable geometry-processing solvers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check:static": "node tools/check_static_site.mjs",
    "check": "npm test && npm run build && npm run check:static",
    "doctor": "node tools/doctor.mjs",
    "preview": "vite preview",
    "test": "vitest run && npm run test:python && npm run test:wasm",
    "test:python": "python3 -m unittest tools/test_polyscope_viewer.py tools/test_polyscope_bridge.py",
    "test:wasm": "node tools/test_wasm_kernel.mjs",
    "test:watch": "vitest",
    "build:wasm": "cmake -S cpp -B build/wasm -DCMAKE_TOOLCHAIN_FILE=$EMSDK/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake && cmake --build build/wasm -j",
    "configure:native": "cmake --preset native",
    "build:native": "cmake --build --preset native",
    "test:native": "ctest --preset native",
    "run:native": "./build/native/geometry-lab-vertex-field",
    "serve:bridge": "python3 tools/polyscope_bridge.py --root dist --port 4174",
    "serve:bridge:python": "python3 tools/polyscope_bridge.py --root dist --port 4174 --viewer tools/polyscope_viewer.py",
    "view:python": "python3 tools/polyscope_viewer.py"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.185.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
